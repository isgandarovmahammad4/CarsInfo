@schema=https
@hostname=localhost
@port=7098

GET {{schema}}://{{hostname}}:{{port}}/api/v1/cars 

### 
GET {{schema}}://{{hostname}}:{{port}}/api/v1/cars 
Accept: application/xml

###
POST {{schema}}://{{hostname}}:{{port}}/api/v2/cars/2/pointsofinterest
Accept: application/json
Content-Type: application/json

{
  "name": "Test Point of Interest",
  "description": "This is a test point of interest."
}

###
@poiid = {{createpoi.response.body.id}}

GET {{schema}}://{{hostname}}:{{port}}/api/v2/cars/2/pointsofinterest/{{poiid}}
Accept: application/json

###

